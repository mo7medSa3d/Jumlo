# Jumlo Companion Media Service configuration template.
# Copy to .env (never commit real tokens) and pass via --env-file or shell export.

# Bind address. Use 127.0.0.1 for local runs or 0.0.0.0 inside Docker.
JUMLO_MEDIA_HOST=127.0.0.1

# Listen port (1-65535).
JUMLO_MEDIA_PORT=8787

# Shared bearer secret required in Authorization: Bearer <token>.
# Mandatory whenever JUMLO_MEDIA_HOST is non-loopback (legacy alias: JUMLO_SERVICE_TOKEN).
JUMLO_MEDIA_TOKEN=replace-with-strong-random-token

# Per-IP sliding-window request limit per 60 seconds (probes /health and /ready are exempt).
JUMLO_MEDIA_RATE_LIMIT=60

# Maximum concurrent /extract and /stream operations.
JUMLO_MEDIA_MAX_CONCURRENT=8

# Structured log verbosity: DEBUG, INFO, WARNING, or ERROR.
JUMLO_MEDIA_LOG_LEVEL=INFO

# Optional Access-Control-Allow-Origin value (e.g. https://app.example.com or *).
# Leave empty to disable CORS headers and reject OPTIONS preflight requests.
JUMLO_MEDIA_CORS_ORIGIN=

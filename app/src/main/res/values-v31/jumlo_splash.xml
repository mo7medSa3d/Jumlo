<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch-screen icon and background. Compose provides the short logo entrance. -->
    <style name="Theme.Jumlo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#0C1231</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">#0C1231</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0C1231</item>
    </style>
</resources>

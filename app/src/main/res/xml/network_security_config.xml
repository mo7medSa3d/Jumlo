<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Direct HTTP downloads and metadata are supported. Runtime guards reject
         HTTPS-to-HTTP redirects; release extractor endpoints require HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

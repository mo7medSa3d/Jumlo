<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only StreamTransfer may use HTTP, after per-job consent. No credential downgrade. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
